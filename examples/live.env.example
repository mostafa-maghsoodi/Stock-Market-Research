# Required for respectful SEC API access.
SEC_USER_AGENT=YourAppName/1.0 your-email@example.com

# Required by default. Generate a long random secret; do not commit it.
GRAHAM_API_KEY=replace-with-a-long-random-secret

# Local-only escape hatch. Do not set this to 0 on a public deployment.
GRAHAM_REQUIRE_AUTH=1

GRAHAM_DB_PATH=./graham_theses.db
GRAHAM_LIVE_HOST=127.0.0.1
GRAHAM_LIVE_PORT=8000

# Set this only when the API is deployed behind a public domain.
PUBLIC_BASE_URL=https://replace-with-your-public-domain.com
